# Copy to .env; every setting is optional.

# Gemini API key for AI-enhanced chart generation
GEMINI_API_KEY=your_key_here

# AI provider: gemini (needs the key above), claude or codex (use your logged-in CLI)
# SONGHERO_AI=claude

# Where charts are written, e.g. your Clone Hero Songs folder
# SONGHERO_OUTPUT=~/Clone Hero/Songs

# Set to 0 to skip drum charting (needs Demucs installed in the venv)
# SONGHERO_DRUMS=0
